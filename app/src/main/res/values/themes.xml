<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ToDo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <style name="Theme.ToDo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ToDo</item>
    </style>

    <style name="Theme.ToDo.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/alarm_bg</item>
    </style>
</resources>
