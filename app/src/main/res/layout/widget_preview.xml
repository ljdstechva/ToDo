<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): a sample list in the widget's own look. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stat_todo"
            android:tint="@color/widget_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/widget_preview_count"
            android:textColor="@color/widget_text_muted"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_preview_add"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_add"
            android:tint="@color/widget_on_accent" />
    </LinearLayout>

    <CheckBox
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:buttonTint="#FF43A047"
        android:text="@string/widget_preview_1"
        android:textColor="@color/widget_text"
        android:textSize="15sp" />

    <CheckBox
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:buttonTint="@color/widget_accent"
        android:text="@string/widget_preview_2"
        android:textColor="@color/widget_text"
        android:textSize="15sp" />

    <CheckBox
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:buttonTint="#FFFBC02D"
        android:checked="true"
        android:text="@string/widget_preview_done"
        android:textColor="@color/widget_text_muted"
        android:textSize="15sp" />
</LinearLayout>
